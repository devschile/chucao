{
  "$description": "Chucao, sistema de diseño para devsChile",
  "color": {
    "$type": "color",
    "$description": "Paleta de colores del sistema",
    "background": {
      "$description": "Fondo",
      "base": { "$value": "#100a1c", "$description": "Fondo base" },
      "top-glow": { "$value": "#201e40", "$description": "Superior del degradado" },
      "bottom-glow": { "$value": "#261226", "$description": "Inferior del degradado" }
    },
    "surface": {
      "$description": "Superficies",
      "default": { "$value": "rgba(32, 30, 64, 0.6)", "$description": "Tarjetas, inputs (con blur)" },
      "hover": { "$value": "rgba(45, 212, 191, 0.08)", "$description": "Fondo en hover" }
    },
    "border": {
      "$description": "Bordes",
      "default": { "$value": "rgba(255, 255, 255, 0.08)", "$description": "Borde en reposo" },
      "hover": { "$value": "rgba(45, 212, 191, 0.3)", "$description": "Borde en hover" }
    },
    "accent": {
      "$description": "Acento",
      "default": { "$value": "#2dd4bf", "$description": "Acento — texto, bordes, botones" },
      "hover": { "$value": "#5ee8d4", "$description": "Acento en hover" }
    },
    "status": {
      "$description": "Estados",
      "positive": { "$value": "#4ade80", "$description": "Estados positivos, como 'disponible'" },
      "positive-background": { "$value": "rgba(34, 197, 94, 0.18)", "$description": "Fondo de estados positivos" },
      "warning": { "$value": "#f87171", "$description": "Estados de advertencia" },
      "warning-background": { "$value": "rgba(248, 113, 113, 0.15)", "$description": "Fondo de estados de advertencia" }
    },
    "text": {
      "$description": "Texto",
      "primary": { "$value": "#ffffff", "$description": "Texto principal" },
      "secondary": { "$value": "rgba(255, 255, 255, 0.55)", "$description": "Texto atenuado" }
    },
    "brand": {
      "$description": "Marca",
      "huemul-dark": { "$value": "#85422b", "$description": "Café oscuro" },
      "huemul-light": { "$value": "#b45b38", "$description": "Café claro" },
      "stroke": { "$value": "#1d1d1b", "$description": "Trazo / texto de marca" }
    }
  },
  "typography": {
    "$type": "fontFamily",
    "$description": "Familias tipográficas",
    "body": { "$value": "Fira Sans, Droid Sans, Helvetica Neue, sans-serif", "$description": "Tipografía de cuerpo" },
    "heading": { "$value": "Inconsolata, monospace", "$description": "Tipografía de títulos" }
  },
  "spacing": {
    "$type": "dimension",
    "$description": "Radios y espaciado",
    "radius": { "$value": "6px", "$description": "Radio de esquinas" }
  },
  "layout": {
    "$type": "dimension",
    "$description": "Restricciones de layout",
    "max-width": { "$value": "68rem", "$description": "Ancho máximo de contenido" }
  }
}
